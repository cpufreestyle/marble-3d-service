# Environment variables for marble-3d-service
# Copy this file to .env and fill in your values

# Required: World Labs API Key
# Get it from: https://worldlabs.ai
WORLD_LABS_API_KEY=your_world_labs_api_key_here

# Optional: Flask secret key (change in production!)
SECRET_KEY=dev-secret-key-change-in-production

# Optional: Server port (default: 5000)
PORT=5000

# Optional: Debug mode (default: False)
DEBUG=False

# Optional: Local LLM settings
# LM Studio: http://localhost:1234/v1
# Ollama: http://localhost:11434
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434

# ===== Stable Zero123 开源3D模型配置（可选） =====
# 模型路径（HuggingFace模型ID或本地路径）
STABLE_3D_MODEL_PATH=stabilityai/stable-zero123
# 生成视图输出目录
STABLE_3D_OUTPUT_DIR=./generated_3d_views
