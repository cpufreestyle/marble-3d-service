# Environment variables for marble-3d-service
# Copy this file to .env and fill in your values

# Required: World Labs API Key
# Get it from: https://worldlabs.ai
WORLD_LABS_API_KEY=your_world_labs_api_key_here

# Optional: Flask secret key (change in production!)
SECRET_KEY=dev-secret-key-change-in-production

# Optional: Server port (default: 5000)
PORT=5000

# Optional: Local LLM settings
# LM Studio: http://localhost:1234/v1
# Ollama: http://localhost:11434
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434

# Optional: Debug mode (default: False)
DEBUG=False
