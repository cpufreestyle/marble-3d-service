# Environment variables for marble-3d-service
# Copy this file to .env and fill in your values

# Required: World Labs API Key
# Get it from: https://worldlabs.ai
WORLD_LABS_API_KEY=your_world_labs_api_key_here

# Optional: Flask secret key (change in production!)
SECRET_KEY=dev-secret-key-change-in-production

# Optional: Server port (default: 5000)
PORT=5000

# Optional: Debug mode (default: False)
DEBUG=False

# ===== 本地 LLM 配置（可选） =====
# 提供方: auto | openai-compatible | lmstudio | vllm | llamacpp | ollama
# auto 模式探测顺序: LLM_BASE_URL → LM Studio → Ollama
#LLM_PROVIDER=auto
# 自定义端点 base_url（OpenAI 兼容服务须含 /v1，如 vLLM: http://localhost:8000/v1）
#LLM_BASE_URL=
# 模型名（留空自动选择探测到的第一个模型）
#LLM_MODEL=
#LLM_TEMPERATURE=0.7
#LLM_TIMEOUT=30

# 旧版 URL 配置（保留向后兼容；LLM_BASE_URL 优先）
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434

# ===== 3D 生成后端配置（可选） =====
# 后端: auto | zero123plus | stable-zero123 | sd-img2img
# auto 按 GPU 显存自动选择：zero123plus → stable-zero123 → sd-img2img（CPU 兜底）
#STABLE_3D_BACKEND=auto
# Zero123++ 模型（一次生成 6 视角，需 6GB+ 显存）
#STABLE_3D_ZERO123PLUS_MODEL=sudo-ai/zero123plus-v1.2
# Stable Zero123 模型（按方位角逐视角，需 6GB+ 显存）
#STABLE_3D_ZERO123_MODEL=ds8nh/Stable-Zero123
# SD img2img 模型（兜底后端，CPU 可用）
#STABLE_3D_MODEL_PATH=stable-diffusion-v1-5/stable-diffusion-v1-5
# 生成视图数量（zero123plus 固定 6，忽略此项）
#STABLE_3D_NUM_VIEWS=4
# 生成视图输出目录
STABLE_3D_OUTPUT_DIR=./generated_3d_views

# ===== 文生图配置（可选） =====
# 模型（任意 HuggingFace ID 或本地路径；SDXL 系自动使用 SDXL 管线）
#TEXT_TO_IMAGE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
# 管线强制指定: auto | sd15 | sdxl（默认 auto 按模型名识别）
#TEXT_TO_IMAGE_PIPELINE=auto
# 默认生成参数（可被请求参数覆盖）
#TEXT_TO_IMAGE_WIDTH=512
#TEXT_TO_IMAGE_HEIGHT=512
#TEXT_TO_IMAGE_STEPS=20
#TEXT_TO_IMAGE_GUIDANCE=7.5
